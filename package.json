{
  "name": "storeloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx --env-file=.env watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "register-webhook": "tsx --env-file=.env scripts/register-webhook.ts",
    "demo-reset": "tsx --env-file=.env scripts/demo-reset.ts",
    "seed-tasks": "tsx --env-file=.env scripts/seed-tasks.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@hono/node-server": "^1.13.0",
    "better-sqlite3": "^13.0.3",
    "chrome-launcher": "^1.2.2",
    "execa": "^9.5.0",
    "hono": "^4.6.0",
    "lighthouse": "^13.6.0",
    "pino": "^9.5.0",
    "playwright": "^1.64.1",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "msw": "^2.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
