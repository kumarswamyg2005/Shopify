# Anthropic
ANTHROPIC_API_KEY=
STORELOOP_MODEL=claude-sonnet-5

# Shopify — this store only. The agent process never receives SHOPIFY_ADMIN_API_TOKEN.
SHOPIFY_STORE=storeloop-demo.myshopify.com
SHOPIFY_API_VERSION=2026-10
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_CLI_THEME_TOKEN=

# ClickUp
CLICKUP_API_TOKEN=
CLICKUP_WORKSPACE_ID=

# Server
PORT=8787
NODE_ENV=development
RUNS_BASIC_AUTH_USER=
RUNS_BASIC_AUTH_PASS=
